# Copy this file, name the copy ".env", and fill in your keys.
# Never share your .env file or upload it to GitHub!

# From https://developer.kroger.com (free). Leave blank to use demo mode.
KROGER_CLIENT_ID=
KROGER_CLIENT_SECRET=

# Optional: from https://console.anthropic.com. Lets AI read messy shopping lists.
# Without it, the site still works. Just separate items with commas.
ANTHROPIC_API_KEY=

PORT=3000
